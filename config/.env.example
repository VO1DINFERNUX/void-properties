# Copy this file to .env and fill in real values. Never commit .env.

# Lead source credentials / API keys (add as sources are implemented)
# COUNTY_RECORDS_API_KEY=

# Contact enrichment — Apollo.io matches an owner's name to a phone/email so
# the outreach providers below have something to send to. See
# src/enrichment/apollo.py. https://app.apollo.io/#/settings/integrations/api
# APOLLO_API_KEY=
# Optional: a publicly reachable URL Apollo can POST a revealed phone number
# to (phone reveal is async/webhook-only on Apollo's end — see apollo.py's
# module docstring). Leave unset to skip phone reveal and rely on email.
# APOLLO_PHONE_WEBHOOK_URL=

# Outreach providers — required for `outreach_queue.py contact ...` to
# actually send. Logging attempts you made yourself (`outreach_queue.py log`)
# needs none of this. See src/outreach/channels.py for how each is used.
#
# Twilio (SMS + voice calls) — https://console.twilio.com
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=        # E.164 format, e.g. +18325551234 — must be a number on your Twilio account
#
# SendGrid (email, via its REST API — no SMTP needed) — https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=       # must be a verified sender identity in your SendGrid account
